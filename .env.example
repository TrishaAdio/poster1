# ==========================================================================
# Telegram API credentials -> https://my.telegram.org  (API development tools)
# The userbot logs in as YOUR account (needed to handle files up to 2 GB).
# ==========================================================================
API_ID=1234567
API_HASH=your_api_hash_here

# ==========================================================================
# POST_CHANNEL = where albums/videos are posted.
# @username, a numeric id like -1001234567890, or an invite link.
# The userbot account must be a member/admin able to post there.
# ==========================================================================
POST_CHANNEL=@your_channel

# ==========================================================================
# Who may send ZIPs to the userbot (comma-separated user ids). The logged-in
# account itself (Saved Messages) is ALWAYS allowed. Leave blank for self-only.
# ==========================================================================
OWNERS=

# ==========================================================================
# Album / pacing tuning (sensible defaults; usually leave as-is)
# ==========================================================================
ALBUM_SIZE=9        # images per native Telegram album (max 10)
MAX_VIDEO_MB=70     # videos larger than this are skipped (not sent)
SEND_DELAY=2        # seconds between posts (avoid flood)
